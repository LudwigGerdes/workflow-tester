  "keywords": [
    "n8n",
    "n8n-workflow",
    "testing",
    "contract-testing",
    "webhook",
    "json-schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LudwigGerdes/workflow-test.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/LudwigGerdes/workflow-test#readme",
  "bugs": "https://github.com/LudwigGerdes/workflow-test/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
