{
  "name": "workflow-test-structure",
  "version": "0.1.0",
  "private": true,
  "description": "Static reads of an n8n workflow for workflow-test: which paths expressions touch, guards, lineage through Set and Code nodes",
  "keywords": [
    "n8n",
    "n8n-workflow",
    "static-analysis",
    "expressions",
    "workflow-automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LudwigGerdes/workflow-test.git",
    "directory": "packages/structure"
  },
  "homepage": "https://github.com/LudwigGerdes/workflow-test#readme",
  "bugs": "https://github.com/LudwigGerdes/workflow-test/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "workflow-test-contracts": "workspace:*"
  }
}
