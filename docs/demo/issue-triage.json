{
  "name": "issue-triage",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "issue-triage",
        "options": {}
      },
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "opened",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Is Opened?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "title",
              "value": "={{ $json.body.issue.title }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "reporter",
              "value": "={{ $json.body.issue.user.login }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "assignee",
              "value": "={{ $json.body.issue.assignee.login }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "repo",
              "value": "={{ $json.body.repository.full_name }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n3",
      "name": "Build Triage Record",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {},
      "id": "n4",
      "name": "Hand Off",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Is Opened?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Opened?": {
      "main": [
        [
          {
            "node": "Build Triage Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Triage Record": {
      "main": [
        [
          {
            "node": "Hand Off",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
