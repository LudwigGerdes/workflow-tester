{
  "name": "workflow-test-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle:node-types": "tsx scripts/bundle-node-types.ts",
